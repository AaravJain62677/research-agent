# Copy this to .env and fill in real values. .env itself is gitignored.

# Testnet wallet — generate a FRESH key, never reuse a real wallet
WALLET_PRIVATE_KEY=0xyourtestnetprivatekey

# x402 facilitator endpoint (public testnet facilitator from docs.x402.org)
FACILITATOR_URL=https://facilitator.example.org

# LLM provider key (planner, fact-check, summarize, report nodes)
LLM_API_KEY=your_llm_api_key

# Chain id for Base Sepolia
CHAIN_NETWORK=eip155:84532
